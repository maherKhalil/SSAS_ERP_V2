{
  "Authentication": {
    "CompromisedPasswords": {
      "Enabled": false
    }
  },
  "AuthenticationTransport": {
    "AllowedOrigins": [ "https://localhost:4200" ],
    "ProxyMode": "Direct",
    "UpstreamDistributedRateLimitingEnforced": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "Jwt": {
    "Issuer": "https://development.ssas.local",
    "Audience": "ssas-erp-development",
    "AccessTokenLifetime": "00:15:00",
    "MaximumEncodedTokenSize": 8192,
    "ClockSkewSeconds": 30
  }
}
