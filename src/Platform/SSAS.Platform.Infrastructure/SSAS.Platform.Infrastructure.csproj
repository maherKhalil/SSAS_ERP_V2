<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="..\SSAS.Platform.Application\SSAS.Platform.Application.csproj" />
    <ProjectReference Include="..\SSAS.Platform.Domain\SSAS.Platform.Domain.csproj" />
    <ProjectReference Include="..\SSAS.Platform.Contracts\SSAS.Platform.Contracts.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\SSAS.BuildingBlocks.Infrastructure\SSAS.BuildingBlocks.Infrastructure.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\SSAS.BuildingBlocks.Localization\SSAS.BuildingBlocks.Localization.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SSAS.Platform.Tests" />
    <InternalsVisibleTo Include="SSAS.Integration.Tests" />
    <!-- FP-006C6: the host-composition tests assert that the PRODUCTION container resolves a tenant model
         containing the module-contributed entities. That is a fact about an internal service, and proving it
         from outside the container would prove something else. -->
    <InternalsVisibleTo Include="SSAS.API.Tests" />
    <!-- Design-time only: the migration tool reuses the ONE fail-fast connection-string contract rather
         than restating it, so ADR-018's operational procedure cannot drift between them. -->
    <InternalsVisibleTo Include="SSAS.Tenant.MigrationTool" />
    <!-- T-253: the cutover contributor set is consumed by BOTH Integration.Tests and Architecture.Tests, so
         it lives in one support assembly rather than being copied. `ITenantModelSource` is internal, and
         this grant replaces nothing: Integration.Tests reached it through the grant above when the same
         definition sat inside that project. -->
    <InternalsVisibleTo Include="SSAS.TestSupport.CutoverModel" />
    <!-- T-253: six cutover-manifest checks moved here from the Integration suite. They assert facts
         about the COMPOSED tenant model, which is an internal service, for the same reason the API tests
         are granted access above. Proving it from outside the composition would prove something else. -->
    <InternalsVisibleTo Include="SSAS.Architecture.Tests" />
  </ItemGroup>

</Project>
